# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/neighborhub"
POSTGRES_PASSWORD="CHANGE_ME"

# JWT secret. Generate a unique value of at least 32 characters:
#   openssl rand -base64 48
# The server refuses published examples, including your-super-secret-jwt-key-here
# and your_long_secure_jwt_secret_key_here. Changing this signs everyone out.
JWT_SECRET=

# Admin login for POST /api/auth/admin/login.
# Use a new username and a password of at least 12 characters.
# admin-account / admin123 is public and is rejected.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email Configuration (for password reset)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password-here"

# Frontend URL (for reset links)
FRONTEND_URL="http://localhost:3000"

# Server
PORT=3000
